{
  "name": "vaultly",
  "version": "0.1.0",
  "private": true,
  "description": "Vaultly — securely store, manage, and share your files.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @vaultly/web",
    "dev:api": "npm run dev -w @vaultly/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@vaultly/shared && npm run build --workspace=@vaultly/web",
    "build:api": "npm run build --workspace=@vaultly/shared && prisma generate --schema=prisma/schema.prisma && npm run build --workspace=@vaultly/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
