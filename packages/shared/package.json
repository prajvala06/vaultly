{
  "name": "@vaultly/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and validation schemas for Vaultly",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No shared tests yet\" && exit 0"
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
