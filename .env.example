# Vaultly environment variables (copy to .env and fill in values)
# Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql://vaultly:vaultly@localhost:5432/vaultly?schema=public

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Use a long random string in production (min 32 characters).
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
COOKIE_NAME=vaultly_access_token
COOKIE_SECURE=false
# Cross-origin production (Vercel frontend + Railway API): set COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SAME_SITE=lax

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vaultly
# Optional: set to true to use unsigned uploads with an upload preset (not recommended for private assets).
CLOUDINARY_USE_UNSIGNED=false
CLOUDINARY_UPLOAD_PRESET=

# --- File limits ---
MAX_FILE_SIZE_BYTES=104857600
# 100 MB default; raise as needed for larger uploads.
STORAGE_QUOTA_BYTES=1073741824
# 1 GB default storage quota per user.

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Gmail SMTP (register confirmation codes) ---
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Vaultly <you@gmail.com>"
REGISTER_OTP_TTL_SECONDS=600