# Vaultly environment variables (copy to .env and fill in values)
# Never commit real secrets.

# --- Database ---
# Local Docker:
DATABASE_URL=postgresql://vaultly:vaultly@localhost:5432/vaultly?schema=public
DIRECT_URL=postgresql://vaultly:vaultly@localhost:5432/vaultly?schema=public
# Prisma Postgres (console.prisma.io → Connect):
# DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# DIRECT_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Production (Zerops API + Vercel frontend):
# CORS_ORIGIN=https://vaultly-store.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# PORT is set by Zerops (4000 in zerops.yml)

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
COOKIE_NAME=vaultly_access_token
COOKIE_SECURE=false
# Production cross-origin (frontend + API on different Vercel URLs):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
COOKIE_SAME_SITE=lax

# --- Cloudinary ---
# Keys stay on the API only. Uploads go browser → Vaultly API → Cloudinary (authenticated).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vaultly

# --- File limits ---
# On Vercel Hobby, request body is capped ~4.5MB. Local/Railway can use higher values.
MAX_FILE_SIZE_BYTES=104857600
STORAGE_QUOTA_BYTES=1073741824

# --- Frontend (apps/frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production: NEXT_PUBLIC_API_URL=https://your-api.vercel.app
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Email (register confirmation codes) ---
# Prefer Resend on Vercel/Railway (HTTPS API). SMTP often blocked or times out.
RESEND_API_KEY=
MAIL_FROM=Vaultly <onboarding@resend.dev>
# Local SMTP fallback:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
REGISTER_OTP_TTL_SECONDS=600
